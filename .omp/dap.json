{
  "adapters": {
    "debugpy": {
      "command": "python",
      "args": ["-m", "debugpy.adapter"],
      "languages": ["python"],
      "fileTypes": [".py"],
      "rootMarkers": ["pyproject.toml", "setup.py", ".git"],
      "launchDefaults": { "request": "launch", "stopOnEntry": true, "justMyCode": false }
    }
  }
}
